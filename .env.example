# PROFCYS Gateway 프런트엔드 환경변수 예시 — 복사하여 .env.production 으로 저장
# 아래 값은 모두 "공개 클라이언트 설정값"이다. 비밀키(서비스 계정 키, 비밀번호)는 절대 넣지 않는다.

# Apps Script gateway-api 웹앱 배포 URL (…/exec)
VITE_API_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec

# Firebase 웹 앱 설정 (Firebase 콘솔 > 프로젝트 설정 > 내 앱). 변경 알림(public/revision) 실시간 구독에만 사용
VITE_FIREBASE_PROJECT_ID=profcys
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=

# 최종 대표 URL (QR코드·안내문에 사용). 실제 배포로 확인된 주소만 입력
VITE_PORTAL_URL=https://profcys.web.app
