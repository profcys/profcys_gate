{
  "name": "profcys-gateway",
  "private": true,
  "version": "3.0.0",
  "description": "PROFCYS 통합 업무지원 플랫폼 (PROFCYS Integrated Business Support Platform)",
  "type": "module",
  "scripts": {
    "dev": "node dev/dev-server.mjs",
    "dev:ui": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "gas:bundle": "node scripts/bundle-gas.mjs",
    "deploy:hosting": "npm run build && firebase deploy --only hosting --project profcys",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes --project profcys"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.7"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
